# ---- copy to .env next to docker-compose.yml and fill in ----

# already in your .env
VELOCITY_SECRET=


# long random string; it is the admin password and signs the ntfy buttons
#   openssl rand -hex 32
WHITELIST_ADMIN_TOKEN=

# where the site and the API live (the API must be HTTPS, GitHub Pages is)
WHITELIST_SITE_URL=https://mc.errornoslash.be
WHITELIST_API_URL=https://mc-api.errornoslash.be

# ntfy: your own server (the Ntfy container), reached over the Internal network
NTFY_URL=http://Ntfy
# the ntfy site's public address, so Approve / Deny also work from the ntfy web app
NTFY_PUBLIC_URL=https://ntfy.errornoslash.be
# pick something hard to guess if anonymous access is allowed on your ntfy
NTFY_TOPIC=mc-whitelist
# docker exec -it Ntfy ntfy token add mc-whitelist  (see the README); leave empty if your ntfy has no auth
NTFY_TOKEN=
